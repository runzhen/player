{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "QQPlayer",
  "version": "0.1.0",
  "identifier": "com.qqplay.qqplayer",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QQPlayer",
        "width": 400,
        "height": 220,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1a1a2e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "frontendDist": "./frontend"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null,
      "infoPlist": "Info.plist"
    }
  }
}
